<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>BatchImageLoaderLibrary</PackageId>
    <Version>1.0.0</Version>
    <Authors>n1tr3x</Authors>
    <Description>Batch image loader with on-disk and SQLite caching.</Description>
    <RepositoryUrl>https://github.com/n1tr3x/BatchImageLoaderLibrary</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.27" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.27" />
    <PackageReference Include="Trinet.Core.IO.Ntfs" Version="4.1.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="404.png" />
  </ItemGroup>

</Project>
