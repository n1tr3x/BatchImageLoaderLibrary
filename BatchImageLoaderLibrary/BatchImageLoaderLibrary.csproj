<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net6, чтобы либу могли подцепить ВСЕ потребители (есть net6.0-windows).
         net6 EOL, но это самый низкий общий знаменатель; наг про EOL глушим осознанно. -->
    <TargetFramework>net6.0-windows</TargetFramework>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Нужен для WPF-вывода CachedImage.ToBitmapImage(); WinForms-потребители не затрагиваются. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>BatchImageLoaderLibrary</PackageId>
    <Version>1.0.0</Version>
    <Authors>n1tr3x</Authors>
    <Description>Batch image loader with on-disk and SQLite caching.</Description>
    <RepositoryUrl>https://github.com/n1tr3x/BatchImageLoaderLibrary</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="6.0.36" />
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
    <PackageReference Include="Trinet.Core.IO.Ntfs" Version="4.1.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="404.png" />
  </ItemGroup>

</Project>
